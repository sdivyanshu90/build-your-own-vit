# =============================================================================
# Example environment configuration for the ViT serving layer.
# Copy to `.env` and adjust. All variables are prefixed with VIT_ and map to
# fields on `vit.serving.settings.ServingSettings` (pydantic-settings).
# NEVER commit a real .env file — it is git-ignored by default.
# =============================================================================

# --- Model / inference ---
# Path to a trained checkpoint (.pt). If empty, the server starts with a
# randomly-initialized model in "degraded" readiness (useful for smoke tests).
VIT_MODEL_CHECKPOINT=

# Device to run inference on: "auto" | "cpu" | "cuda" | "cuda:0"
VIT_DEVICE=auto

# Number of intra-op threads for CPU inference (0 = library default).
VIT_NUM_THREADS=0

# --- HTTP server ---
VIT_HOST=0.0.0.0
VIT_PORT=8080
VIT_ROOT_PATH=
VIT_LOG_LEVEL=INFO
VIT_LOG_JSON=true

# --- Security / limits ---
# Comma-separated list of allowed CORS origins ("*" to allow all — avoid in prod).
VIT_CORS_ORIGINS=
# Max upload size in bytes (default 5 MiB).
VIT_MAX_UPLOAD_BYTES=5242880
# Requests-per-minute per client IP for the /v1/predict endpoint (0 disables).
VIT_RATE_LIMIT_RPM=120
# Optional bearer token; when set, mutating/predict endpoints require it.
VIT_API_TOKEN=

# --- Observability ---
VIT_ENABLE_METRICS=true
